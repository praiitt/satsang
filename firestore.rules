rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Allow users to create documents in customGuruIntents collection
    // but not read, update, or delete (for privacy)
    match /customGuruIntents/{intentId} {
      allow create: if request.auth != null || true; // Allow anonymous users to submit
      allow read: if false; // No client-side reads
      allow update: if false; // No updates
      allow delete: if false; // No deletes
    }

    // Music Tracks: Allow users to read/write their own tracks
    match /music_tracks/{trackId} {
      allow read: if request.auth != null; // Allow all auth users to read (for sharing/social) or restrict: (resource.data.userId == request.auth.uid || resource.data.isPublic == true);
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    // Users: Allow users to read/write their own profile
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}

