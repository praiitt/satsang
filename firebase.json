{
  "hosting": {
    "public": "public",
    "rewrites": [
      {
        "source": "/satsang-auth-server/**",
        "run": {
          "serviceId": "satsang-auth-server",
          "region": "asia-south1"
        }
      },
      {
        "source": "**",
        "run": {
          "serviceId": "satsang-frontend",
          "region": "asia-south1"
        }
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules"
  },
  "storage": {
    "rules": "storage.rules"
  }
}